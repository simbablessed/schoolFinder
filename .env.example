# ==============================================================================
# School Finder Zimbabwe - Environment Configuration
# Neon Postgres + Cloudflare Workers + Clerk Authentication
# ==============================================================================

# 1. CLERK AUTHENTICATION
# Obtain from https://dashboard.clerk.com/ -> API Keys
# When left empty, the app runs in built-in Temp/Demo Credentials mode (no sign-up needed)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_key_schoolfinder_zim

# 2. NEON POSTGRESQL DATABASE
# Obtain from https://console.neon.tech/ -> Dashboard -> Connection String
DATABASE_URL=postgresql://neondb_owner:sample_password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. CLOUDFLARE EDGE API URL (Optional - if blank, uses direct client / local proxy)
# VITE_API_URL=https://schoolfinder-backend.yoursubdomain.workers.dev
